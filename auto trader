local readyLock={}
local function fireReadyOnce()
    local t=getTradeRoot(); if not t then return false,"no trade" end
    local other=t:FindFirstChild("Other"); if not other then return false,"no Other" end
    local rb=other:FindFirstChild("ReadyButton"); if not rb then return false,"no ReadyButton" end
    local txt=rb:FindFirstChild("Txt")
    if not (txt and txt:IsA("TextLabel")) then return false,"no Txt" end
    local s=txt.Text:lower()
    if not (s:find("accept") or s:find("confirm") or s:find("ready")) then return false,"txt="..txt.Text end
    local p=getPartnerName() or "?"
    local t0=readyLock[p]; if t0 and (os.clock()-t0)<POLICY.readyLockout then return false,"lockout" end
    fireClick(rb); readyLock[p]=os.clock()
    return true,"fired"
end

-- ===== NOTIFICATION HOOK =====
task.spawn(function()
    local p=pg(); if not p then return end
    local tp=p:FindFirstChild("TradePrompts")
    if not tp then tp=p:WaitForChild("TradePrompts",60) end
    if not tp then log("notif: TradePrompts NEVER appeared"); return end
    log("notif: TradePrompts found; mouse1click="..type(mouse1click).." mousemoveabs="..type(mousemoveabs))
    local function tryAcceptPrompt(prompt)
        local lbl=prompt:FindFirstChild("Label")
        if not lbl or lbl.Text~="Trade Request" then return end
        local yes=prompt:FindFirstChild("Yes"); if not yes then log("notif: no Yes"); return end
        local tb=yes:IsA("TextButton") and yes or yes:FindFirstChildWhichIsA("TextButton")
        if not tb then log("notif: no TextButton under Yes"); return end
        task.wait(0.2)
        notifyClick(tb)
    end
    for _,child in ipairs(tp:GetChildren()) do tryAcceptPrompt(child) end
    tp.ChildAdded:Connect(function(child) task.defer(function() tryAcceptPrompt(child) end) end)
end)

-- ===== NEGOTIATION =====
local NEGO={rounds=0,last=0,partner=nil,lastIncoming=""}
local lastReply=""
local function negotiate(text)
    if not POLICY.autoChat then return end
    if SENT_TEXTS[text:lower()] then return end
    if NEGO.partner~=getPartnerName() then NEGO.rounds=0; NEGO.last=0; NEGO.partner=getPartnerName(); NEGO.lastIncoming="" end
    if text==NEGO.lastIncoming then return end
    NEGO.lastIncoming=text
    local now=os.clock(); if now-NEGO.last<POLICY.chatMinGap then return end; NEGO.last=now
    local l=text:lower()
    if l:find("add") or l:find("more") then
        NEGO.rounds=NEGO.rounds+1
        if NEGO.rounds==1 then say("i cant add, its fair"); lastReply="cant add, its fair"
        elseif NEGO.rounds==2 then say("its fair bruh i cant add"); lastReply="its fair bruh"
        else say("no thanks, gl"); lastReply="no thanks" end
        return
    end
    if l:find("no") or l:find("nty") or l:find("nah") or l:find("pass") then say("no thanks"); lastReply="no thanks"; return end
    for name in pairs(V) do
        if l:find(name:lower(),1,true) then
            local their=readTheirSide(); local th=listValue(their); local target=V[name]
            if th<target then NEGO.rounds=NEGO.rounds+1; if NEGO.rounds<=2 then say("add"); lastReply="add" else say("its fair, no thanks"); lastReply="fair, no" end
            else say("ok deal"); lastReply="ok deal" end
            return
        end
    end
end

