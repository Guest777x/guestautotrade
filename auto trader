-- Your:  TradeLiveTrade.TradeLiveTrade.Your.ScrollingFrame.<Cards>.<Card>.Spacer.Title / Cash
-- Other: TradeLiveTrade.TradeLiveTrade.Other.ScrollingFrame.<Cards>...
local function readSideCards(sideName)
    local t=getTradeRoot(); if not t then return {} end
    local side=t:FindFirstChild(sideName); if not side then return {} end
    local sf=side:FindFirstChild("ScrollingFrame"); if not sf then return {} end
    local out={}
    -- iterate every descendant Frame that has a Title label
    for _,card in ipairs(sf:GetDescendants()) do
        if card:IsA("GuiObject") then
            local title=nil
            local spacer=card:FindFirstChild("Spacer",true)
            if spacer then title=spacer:FindFirstChild("Title") end
            if not title then
                local sp=card:FindFirstChild("Spacer")
                if sp then title=sp:FindFirstChild("Title") end
            end
            if not title then
                for _,d in ipairs(card:GetDescendants()) do
                    if d:IsA("TextLabel") and d.Name=="Title" then title=d; break end
                end
            end
            if title and type(title.Text)=="string" and title.Text~="" then
                local clean=title.Text:gsub("<[^>]+>",""):gsub("^%s+",""):gsub("%s+$","")
                if clean~="" and clean~="Brainrot Name" and clean~="Template" then
                    -- find mutation: look inside same spacer for any TextLabel with a known mut
                    local mut=nil
                    local container=spacer or card
                    for _,d in ipairs(container:GetDescendants()) do
                        if d:IsA("TextLabel") and d~=title and type(d.Text)=="string" and #d.Text<30 then
                            local m=mutOf(d.Text)
                            if MUT_MULT[m] and m~="None" then mut=m; break end
                        end
                    end
                    out[#out+1]={Index=clean,Mutation=mut}
                end
            end
        end
    end
    -- dedupe
    local seen={}; local dedup={}
    for _,e in ipairs(out) do
        local k=e.Index.."|"..tostring(e.Mutation)
        if not seen[k] then seen[k]=true; dedup[#dedup+1]=e end
    end
    return dedup
end
local function readMySide() return readSideCards("Your") end
local function readTheirSide() return readSideCards("Other") end

