task.spawn(function()
    while gui.Parent do
        pcall(function()
            if not tradeOpen() then
                if status.Text=="READY FIRED" or status.Text:find("REPLIED") then
                    -- keep last message visible briefly
                else
                    status.Text="IDLE"; status.TextColor3=THEME.DIM
                end
                readout.Text="open a trade — values shown here"
                return
            end
            local my=readMySide(); local their=readTheirSide()
            local mv=listValue(my); local tv=listValue(their)
            local p=getPartnerName() or "?"
            local muts={}
            for _,e in ipairs(my) do if e.Mutation then muts[#muts+1]="MY:"..e.Index.."["..e.Mutation.."]" end end
            for _,e in ipairs(their) do if e.Mutation then muts[#muts+1]="THEM:"..e.Index.."["..e.Mutation.."]" end end
            readout.Text=("PARTNER: %s\nMY: %dG (%d) | THEIRS: %dG (%d)\nMARGIN: %+dG\n%s"):format(
                p,mv,#my,tv,#their,tv-mv,table.concat(muts,", "))
            if POLICY.autoAccept and #their>0 and (tv-mv)>=POLICY.minMargin then
                local ok,reason=fireReadyOnce()
                if ok then status.Text="READY FIRED ("..p..")"; status.TextColor3=THEME.SUCCESS
                else status.Text="ready blocked: "..tostring(reason); status.TextColor3=THEME.DIM end
            end
        end)
        task.wait(POLICY.tradePollInterval)
    end
end)

-- chat listener
local function attachChat()
    local t=getTradeRoot(); if not t then return end
    local ch=t:FindFirstChild("Chat"); if not ch then return end
    for _,k in ipairs({"NormalChat","RestrictedChat"}) do
        local c=ch:FindFirstChild(k); if not c then continue end
        local sf=c:FindFirstChild("ScrollingFrame"); if not sf then continue end
        sf.ChildAdded:Connect(function(child)
            task.defer(function()
                task.wait(0.25)
                local lbl=child:FindFirstChild("Label",true)
                if not lbl or type(lbl.Text)~="string" then return end
                if lbl.Text=="Template" or child.Name=="TemplateYou" then return end
                local pi=child:FindFirstChild("PlayerImage"); pi=pi and pi:FindFirstChild("Headshot")
                if pi and type(pi.Image)=="string" then
                    local m=pi.Image:match("id=(%d+)")
                    if m and tonumber(m)==LP.UserId then return end
                end
                negotiate(lbl.Text)
            end)
        end)
    end
end
task.spawn(function()
    while gui.Parent do
        if getTradeRoot() then pcall(attachChat); break end
        task.wait(1.5)
    end
end)

