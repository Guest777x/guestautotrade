local SENT_TEXTS={}
local lastSayAt=0
local function getChatBox()
    local t=getTradeRoot(); if not t then return nil end
    local ch=t:FindFirstChild("Chat"); if not ch then return nil end
    local nc=ch:FindFirstChild("NormalChat"); if not nc then return nil end
    local cb=nc:FindFirstChild("ChatBox"); if not cb then return nil end
    local tb=cb:FindFirstChild("TextBox")
    if tb and tb:IsA("TextBox") then return tb end
    return cb:FindFirstChildWhichIsA("TextBox")
end
local function fireReturnIn(box)
    if not box or not box:IsA("TextBox") then return false end
    if not CAP.firesignal then return false end
    local ok=false
    pcall(function() firesignal(box.FocusLost,true,Enum.KeyCode.Return); ok=true end)
    return ok
end
local function say(text)
    if not POLICY.autoChat then return false end
    if type(text)~="string" or text=="" then return false end
    local now=os.clock()
    if now-lastSayAt<POLICY.chatMinGap then return false end
    local box=getChatBox(); if not box then logWarn("say: no chat box"); return false end
    local ok=false
    pcall(function()
        box.Text=text
        fireReturnIn(box)
        ok=true
    end)
    if ok then
        lastSayAt=os.clock()
        SENT_TEXTS[text:lower()]=os.time()
        logOk("say: "..text)
    else
        logErr("say: failed to fire")
    end
    return ok
end

