-- ===== CHAT (real path from DUMP B, English only, no HTTP) =====
local SENT_TEXTS={}
local lastSayAt=0
local function getChatBox()
    local t=getTradeRoot(); if not t then return nil end
    local ch=t:FindFirstChild("Chat"); if not ch then return nil end
    local nc=ch:FindFirstChild("NormalChat")
    if nc then
        local cb=nc:FindFirstChild("ChatBox")
        if cb then
            local tb=cb:FindFirstChild("TextBox")
            if tb and tb:IsA("TextBox") then return tb end
            local anyBox=cb:FindFirstChildWhichIsA("TextBox")
            if anyBox then return anyBox end
        end
    end
    return nil
end
local function say(text)
    if not POLICY.autoChat then return false end
    if type(text)~="string" or text=="" then return false end
    local now=os.clock()
    if now-lastSayAt < POLICY.chatMinGap then return false end
    local box=getChatBox(); if not box then return false end
    local ok=false
    pcall(function()
        box.Text=text
        fireReturnIn(box)
        ok=true
    end)
    if ok then lastSayAt=os.clock(); SENT_TEXTS[text:lower()]=os.time() end
    return ok
end

-- ===== READY BUTTON (one click per partner per lockout window) =====
local readyLock={}
local function readyAvailable(partner)
    local t=readyLock[partner]; if not t then return true end
    return (os.clock()-t)>=POLICY.readyLockout
end
local function fireReadyOnce()
    local t=getTradeRoot(); if not t then return false end
    local other=t:FindFirstChild("Other"); if not other then return false end
    local rb=other:FindFirstChild("ReadyButton"); if not rb then return false end
    local txt=rb:FindFirstChild("Txt")
    if not (txt and txt:IsA("TextLabel")) then return false end
    local s=txt.Text:lower()
    if not (s:find("accept") or s:find("confirm") or s:find("ready")) then return false end
    local p=getPartnerName() or "?"
    if not readyAvailable(p) then return false,"lockout" end
    fireClick(rb)
    readyLock[p]=os.clock()
    return true
end

-- ===== NOTIFICATION (real path from DUMP A: TradePrompts.Prompt) =====
local function hookNotification()
    task.spawn(function()
        local p=pg(); if not p then return end
        local tp=p:WaitForChild("TradePrompts",30)
        if not tp then return end
        local function tryAcceptPrompt(prompt)
            local lbl=prompt:FindFirstChild("Label")
            if not lbl or lbl.Text~="Trade Request" then return end
            local yes=prompt:FindFirstChild("Yes")
            if not yes then return end
            -- single firesignal; Yes is a TextButton in your build
            local tb=yes:IsA("TextButton") and yes or yes:FindFirstChildWhichIsA("TextButton")
            if tb then fireClick(tb) end
        end
        for _,child in ipairs(tp:GetChildren()) do tryAcceptPrompt(child) end
        tp.ChildAdded:Connect(function(child) task.defer(function() tryAcceptPrompt(child) end) end)
    end)
end
hookNotification()

-- ===== NEGOTIATION (English-only, echo-guarded) =====
local NEGO={rounds=0,last=0,partner=nil,lastIncoming=""}
local lastReply=""
local function negotiate(text)
    if not POLICY.autoChat then return end
    if SENT_TEXTS[text:lower()] then return end
    if NEGO.partner~=getPartnerName() then NEGO.rounds=0; NEGO.last=0; NEGO.partner=getPartnerName(); NEGO.lastIncoming="" end
    if text==NEGO.lastIncoming then return end
    NEGO.lastIncoming=text
    local now=os.clock(); if now-NEGO.last<POLICY.chatMinGap then return end; NEGO.last=now
    local l=text:lower()
    if l:find("add") or l:find("more") or l:find("%+") then
        NEGO.rounds=NEGO.rounds+1
        if NEGO.rounds==1 then say("i cant add, its fair"); lastReply="cant add, its fair"
        elseif NEGO.rounds==2 then say("its fair bruh i cant add"); lastReply="its fair bruh"
        else say("no thanks, gl"); lastReply="no thanks" end
        return
    end
    if l:find("no") or l:find("nty") or l:find("nah") or l:find("pass") then say("no thanks"); lastReply="no thanks"; return end
    for name in pairs(V) do
        if l:find(name:lower(),1,true) then
            local their=readTheirSide()
            local th=listValue(their)
            local target=V[name]
            if th<target then
                NEGO.rounds=NEGO.rounds+1
                if NEGO.rounds<=2 then say("add"); lastReply="add" else say("its fair, no thanks"); lastReply="fair, no" end
            else
                say("ok deal"); lastReply="ok deal"
            end
            return
        end
    end
end

