-- ===== CLICK (multiple paths, no VIM) =====
local function fireClick(btn)
    if not btn then return false,"no btn" end
    local fired=false
    pcall(function()
        if firesignal then
            pcall(function() firesignal(btn.Activated); fired=true end)
            pcall(function() firesignal(btn.MouseButton1Click); fired=true end)
        end
    end)
    return fired and "firesignal" or "none"
end

-- Notification click without VIM: mouse1click / mouse split / firesignal fallback
local function mouseClickAt(absX, absY)
    -- path 1: single-call mouse1click with absolute screen position
    if type(mouse1click)=="function" then
        local moved=false
        if type(mousemoverel)=="function" then
            -- some executors require a relative move first
            pcall(function() mousemoverel(0,0) end)
        end
        local ok=pcall(function() mouse1click() end)
        if ok then return "mouse1click" end
    end
    -- path 2: split press/release + absolute move
    if type(mousemoveabs)=="function" and type(mouse1press)=="function" and type(mouse1release)=="function" then
        local ok=pcall(function()
            mousemoveabs(absX,absY)
            task.wait(0.03)
            mouse1press()
            task.wait(0.04)
            mouse1release()
        end)
        if ok then return "mouse press/release" end
    end
    return "no mouse API"
end

local function notifyClick(btn)
    if not btn then return false,"no btn" end
    -- firesignal first (harmless, in case this button listens to it)
    local fr=fireClick(btn)
    -- then mouse API (position-based)
    local ap=btn.AbsolutePosition
    local asz=btn.AbsoluteSize
    local cx=ap.X+asz.X/2
    local cy=ap.Y+asz.Y/2
    local mres=mouseClickAt(cx,cy)
    log("notif: firesignal="..fr.." mouse="..mres.." at ("..math.floor(cx)..","..math.floor(cy)..")")
    return true,("firesignal+"..mres)
end

local function fireReturnIn(box)
    if not box or not box:IsA("TextBox") then return false end
    local ok=false
    pcall(function() if firesignal then firesignal(box.FocusLost,true,Enum.KeyCode.Return); ok=true end end)
    return ok
end

