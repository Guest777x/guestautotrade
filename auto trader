local function mutOf(r)
    if not r or r=="" or r=="None" or r=="nil" then return "None" end
    local s=tostring(r):gsub("^%s+",""):gsub("%s+$",""):gsub("<[^>]+>","")
    return MUT_ALIAS[s] or (MUT_MULT[s] and s) or s
end
local function itemValue(e) if type(e)~="table" then return 0 end local b=V[e.Index]; if not b then return 0 end return b*(MUT_MULT[mutOf(e.Mutation)] or 1.0) end
local function listValue(l) local t=0 if type(l)~="table" then return 0 end for _,e in ipairs(l) do t=t+itemValue(e) end return t end

