local readyLock={}
local function fireReadyOnce()
    local t=getTradeRoot()
    if not t then return false,"no trade" end
    local other=t:FindFirstChild("Other")
    if not other then return false,"no Other" end
    local rb=other:FindFirstChild("ReadyButton")
    if not rb then return false,"no ReadyButton" end
    local txt=rb:FindFirstChild("Txt") or rb:FindFirstChildWhichIsA("TextLabel",true)
    if not (txt and txt:IsA("TextLabel")) then return false,"no Txt" end
    local s=txt.Text:lower()
    if not (s:find("accept") or s:find("confirm") or s:find("ready")) then
        return false,"txt="..txt.Text
    end
    local p=getPartnerName() or "?"
    local t0=readyLock[p]
    if t0 and (os.clock()-t0)<POLICY.readyLockout then
        return false,("lockout %ds"):format(math.floor(POLICY.readyLockout-(os.clock()-t0)))
    end
    clickChain(rb,"ready")
    readyLock[p]=os.clock()
    return true,"fired"
end

