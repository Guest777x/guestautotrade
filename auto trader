-- accept loop
local lastSig=nil; local lastT=0
task.spawn(function()
    while gui.Parent do
        pcall(function()
            if not tradeOpen() then
                if not status.Text:find("ACCEPT") and not status.Text:find("DUMP") and not status.Text:find("SET") and not status.Text:find("REPLIED") then
                    status.Text="IDLE"; status.TextColor3=THEME.DIM
                end
                readout.Text="open a trade — values shown here"
                return
            end
            local my,their=getTradeSideLists()
            local mv=listValue(my); local tv=listValue(their)
            local p=getPartnerName() or "?"
            readout.Text=("PARTNER: %s\nMY: %dG (%d) | THEIRS: %dG (%d)\nMARGIN: %+dG"):format(p,mv,#my,tv,#their,tv-mv)
            if not POLICY.autoAccept then return end
            if #their==0 then
                status.Text="TRADE OPEN — THEIRS 0"; status.TextColor3=THEME.DIM
                return
            end
            if (tv-mv)<POLICY.minMargin then
                status.Text=("WAIT — MARGIN %+dG"):format(tv-mv); status.TextColor3=THEME.DIM
                return
            end
            local sig=("%s|%d|%d"):format(p,mv,tv)
            if sig==lastSig and (os.clock()-lastT)<4 then return end
            local clicked=false
            if tryReadyButton() then clicked=true end
            if not clicked then
                local b=findBtn({"accept","confirm"})
                if b then clickGui(b); clicked=true end
            end
            if clicked then
                lastSig=sig; lastT=os.clock()
                say("deal, thanks")
                status.Text="ACCEPTED: "..p; status.TextColor3=THEME.SUCCESS
            else
                status.Text="FAIR — NO BTN"; status.TextColor3=THEME.DANGER
            end
        end)
        task.wait(0.4)
    end
end)

-- chat listener
local function attachChat()
    local t=getTradeRoot(); if not t then return end
    local ch=t:FindFirstChild("Chat"); if not ch then return end
    for _,k in ipairs({"NormalChat","RestrictedChat"}) do
        local c=ch:FindFirstChild(k); if not c then continue end
        local sf=c:FindFirstChild("ScrollingFrame"); if not sf then continue end
        sf.ChildAdded:Connect(function(child)
            task.defer(function()
                task.wait(0.15)
                local lbl=child:FindFirstChild("Label",true); if not lbl or type(lbl.Text)~="string" then return end
                local pi=child:FindFirstChild("PlayerImage"); pi=pi and pi:FindFirstChild("Headshot")
                if pi and type(pi.Image)=="string" then local m=pi.Image:match("id=(%d+)"); if m and tonumber(m)==LP.UserId then return end end
                negotiate(lbl.Text)
                if lastReply~="" then status.Text="REPLIED: "..lastReply; status.TextColor3=THEME.ACCENT end
            end)
        end)
    end
end
