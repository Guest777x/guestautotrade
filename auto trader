-- ============ NEGOTIATION ============
local NEGO={rounds=0,last=0,partner=nil,opened=0}
local function resetNego(p) NEGO.rounds=0; NEGO.last=0; NEGO.partner=p end
local lastReply=""
local function negotiate(text)
    if not POLICY.autoChat then return end
    if NEGO.partner~=getPartnerName() then resetNego(getPartnerName()) end
    local now=os.clock(); if now-NEGO.last<2 then return end; NEGO.last=now
    local l=text:lower()
    if l:find("add") or l:find("more") or l:find("+") then
        NEGO.rounds=NEGO.rounds+1
        if NEGO.rounds==1 then say("i cant add, its fair"); lastReply="cant add, its fair"
        elseif NEGO.rounds==2 then say("its fair bruh i cant add"); lastReply="its fair bruh"
        else say("no thanks, gl"); lastReply="no thanks" end
        return
    end
    if l:find("no") or l:find("nty") or l:find("nah") or l:find("pass") then say("no thanks"); lastReply="no thanks"; return end
    for name in pairs(V) do
        if l:find(name:lower(),1,true) then
            local my,their=readAll()
            local th=listValue(their)
            if th<NEGO.opened then NEGO.rounds=NEGO.rounds+1; if NEGO.rounds<=2 then say("add"); lastReply="add" else say("its fair, no thanks"); lastReply="fair, no" end
            else say("ok deal"); lastReply="ok deal" end
            return
        end
    end
end

-- ============ BUY FLOW ============
local Sync=(function() local p=RS:FindFirstChild("Packages"); p=p and p:FindFirstChild("Synchronizer"); if p then local ok,r=pcall(require,p); if ok then return r end end end)()
local function plotOf(ownerName)
    local plots=workspace:FindFirstChild("Plots"); if not plots or not Sync then return nil end
    for _,c in ipairs(plots:GetChildren()) do
        local ok,t=pcall(function() return Sync:GetTableFromChannel(c.Name) end)
        if ok and type(t)=="table" and t.Owner then
            local n=typeof(t.Owner)=="Instance" and t.Owner.Name or tostring(t.Owner)
            if n==ownerName then return c.Name,t end
        end
    end
end
local function findSeller(name)
    if not Sync then return nil end
    local plots=workspace:FindFirstChild("Plots"); if not plots then return end
    for _,c in ipairs(plots:GetChildren()) do
        local ok,t=pcall(function() return Sync:GetTableFromChannel(c.Name) end)
        if ok and type(t)=="table" and type(t.AnimalList)=="table" then
            local o=typeof(t.Owner)=="Instance" and t.Owner.Name or tostring(t.Owner)
            if o~=LP.Name then for _,e in ipairs(t.AnimalList) do if e.Index==name then return o,e end end end
        end
    end
end
local function buyFrom(name)
    local owner,entry=findSeller(name); if not owner then return false,"seller not found" end
    local mv=itemValue(entry); local off=offerFor(mv)
    local pn=plotOf(owner); local plots=workspace:FindFirstChild("Plots")
    local plot=plots and pn and plots:FindFirstChild(pn); if not plot then return false,"plot missing" end
    local prompt
    for _,d in ipairs(plot:GetDescendants()) do if d:IsA("ProximityPrompt") and d.ActionText=="SEND TRADE" then prompt=d; break end end
    if not prompt then return false,"no prompt" end
    pcall(function() fireproximityprompt(prompt) end)
    task.wait(1.0); resetNego(owner); NEGO.opened=mv
    say(("offering %d garamas, that's fair"):format(math.floor(off)))
    return true,("offer %d to %s"):format(math.floor(off),owner)
end

