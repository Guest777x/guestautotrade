local function hookNotification()
    task.spawn(function()
        local p=pg()
        if not p then logErr("notif: no PlayerGui"); return end
        local tp=p:FindFirstChild("TradePrompts")
        if not tp then
            logWarn("notif: TradePrompts not present, waiting")
            tp=p:WaitForChild("TradePrompts",60)
        end
        if not tp then logErr("notif: TradePrompts NEVER appeared"); return end
        logOk("notif: TradePrompts found")
        local function tryAcceptPrompt(prompt)
            local lbl=prompt:FindFirstChild("Label")
            if not lbl or not lbl:IsA("TextLabel") then return end
            if lbl.Text~="Trade Request" then return end
            local yes=prompt:FindFirstChild("Yes")
            if not yes then logWarn("notif: no Yes on "..prompt.Name); return end
            local tb=yes:IsA("TextButton") and yes or yes:FindFirstChildWhichIsA("TextButton")
            if not tb then logWarn("notif: no TextButton under Yes"); return end
            task.wait(0.2)
            clickChain(tb,"notif-yes")
        end
        for _,c in ipairs(tp:GetChildren()) do tryAcceptPrompt(c) end
        tp.ChildAdded:Connect(function(c) task.defer(function() tryAcceptPrompt(c) end) end)
    end)
end

-- ================================================================
-- NEGOTIATION
-- ================================================================
local NEGO={rounds=0,last=0,partner=nil,lastIncoming=""}
local function resetNego(p)
    NEGO.rounds=0; NEGO.last=0; NEGO.partner=p; NEGO.lastIncoming=""
end
local function negotiate(text)
    if not POLICY.autoChat then return end
    if SENT_TEXTS[text:lower()] then return end
    local p=getPartnerName()
    if NEGO.partner~=p then resetNego(p) end
    if text==NEGO.lastIncoming then return end
    NEGO.lastIncoming=text
    local now=os.clock()
    if now-NEGO.last<POLICY.chatMinGap then return end
    NEGO.last=now
    local l=text:lower()
    if l:find("add") or l:find("more") or l:find("pls") then
        NEGO.rounds=NEGO.rounds+1
        if NEGO.rounds==1 then say("i cant add, its fair")
        elseif NEGO.rounds==2 then say("its fair bruh i cant add")
        else say("no thanks, gl") end
        return
    end
    if l:find("nty") or l:find("nah") or l:find("pass") or (l:find("no") and not l:find("not")) then
        say("no thanks"); return
    end
    if l:find("deal") or l:find("ok") or l:find("fine") then
        say("ok deal, thank you"); return
    end
    for name in pairs(V) do
        if l:find(name:lower(),1,true) then
            local their=select(1,readTheirSide())
            local th=listValue(their)
            local target=V[name]
            if th<target then
                NEGO.rounds=NEGO.rounds+1
                if NEGO.rounds<=2 then say("add") else say("its fair, no thanks") end
            else
                say("ok deal")
            end
            return
        end
    end
end

