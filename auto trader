-- ===== NEGOTIATION =====
local NEGO={rounds=0,last=0,partner=nil,lastIncoming=""}
local lastReply=""
local function tryBuildOfferInfo(targetValue)
    local list=select(1,getMyPlotAnimalList())
    if #list==0 then return "plot empty" end
    local sorted={}
    for _,e in ipairs(list) do
        if type(e)=="table" and e.Index and e.Index~="Empty" then sorted[#sorted+1]={e=e,v=itemValue(e)} end
    end
    table.sort(sorted,function(a,b) return a.v<b.v end)
    local sum=0; local pick={}
    for _,x in ipairs(sorted) do
        if sum>=targetValue then break end
        sum=sum+x.v; pick[#pick+1]=x.e.Index
    end
    return ("would offer: %d items = %dG [%s]"):format(#pick,math.floor(sum),table.concat(pick,", "))
end
local function negotiate(text)
    if not POLICY.autoChat then return end
    if SENT_TEXTS[text:lower()] then return end
    if NEGO.partner~=getPartnerName() then NEGO.rounds=0; NEGO.last=0; NEGO.partner=getPartnerName(); NEGO.lastIncoming="" end
    if text==NEGO.lastIncoming then return end
    NEGO.lastIncoming=text
    local now=os.clock(); if now-NEGO.last<2.5 then return end; NEGO.last=now
    local l=text:lower()
    if l:find("add") or l:find("more") or l:find("%+") then
        NEGO.rounds=NEGO.rounds+1
        if NEGO.rounds==1 then say("i cant add, its fair"); lastReply="cant add, its fair"
        elseif NEGO.rounds==2 then say("its fair bruh i cant add"); lastReply="its fair bruh"
        else say("no thanks, gl"); lastReply="no thanks" end
        return
    end
    if l:find("no") or l:find("nty") or l:find("nah") or l:find("pass") then say("no thanks"); lastReply="no thanks"; return end
    for name in pairs(V) do
        if l:find(name:lower(),1,true) then
            local their=readTheirSide()
            local th=listValue(their)
            local target=V[name]
            if th<target then
                lastReply=tryBuildOfferInfo(target)
                NEGO.rounds=NEGO.rounds+1
                if NEGO.rounds<=2 then say("add") else say("its fair, no thanks") end
            else
                say("ok deal"); lastReply="ok deal"
            end
            return
        end
    end
end

