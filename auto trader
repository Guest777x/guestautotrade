end

-- ===== TRADE SIDES =====
local function getTradeSideLists()
    local t=getTradeRoot(); if not t then return {},{},nil end
    local me,them={}, {}
    local foundMe,foundThem=false,false
    for _,d in ipairs(t:GetDescendants()) do
        if d:GetAttribute("AnimalList")~=nil then
            local list=d:GetAttribute("AnimalList")
            if type(list)=="table" then
                local n=d:GetFullName():lower()
                if n:find("your") or n:find("my") or n:find("offering") then me=list; foundMe=true
                elseif n:find("their") or n:find("requesting") then them=list; foundThem=true end
            end
        end
        if d:IsA("StringValue") and d.Value~="" and d.Value:sub(1,1)=="{" then
            local ok,dec=pcall(function() return HS:JSONDecode(d.Value) end)
            if ok and type(dec)=="table" then
                local n=d:GetFullName():lower()
                if n:find("your") or n:find("my") then me=dec; foundMe=true
                elseif n:find("their") then them=dec; foundThem=true end
            end
        end
    end
    if not (foundMe and foundThem) then
        local function scan(hints)
            local out={}
            for _,d in ipairs(t:GetDescendants()) do
                if d:IsA("TextLabel") and type(d.Text)=="string" then
                    local clean=d.Text:gsub("<[^>]+>",""):gsub("^%s+",""):gsub("%s+$","")
                    if V[clean] then
                        local full=d:GetFullName():lower()
                        for _,h in ipairs(hints) do
                            if full:find(h,1,true) then
                                local mut=nil
                                for _,sib in ipairs(d.Parent:GetChildren()) do
                                    if sib:IsA("TextLabel") and sib~=d then
                                        local m=mutOf(sib.Text); if MUT_MULT[m] then mut=m; break end
                                    end
                                end
                                out[#out+1]={Index=clean,Mutation=mut}; break
                            end
                        end
                    end
                end
            end
            return out
        end
        local uiMe=scan({"youritems","myitems","myoffer","yourtrade","offering"})
        local uiThem=scan({"theiritems","theiroffer","theirtrade","requesting"})
        if not foundMe and #uiMe>0 then me=uiMe; foundMe=true end
        if not foundThem and #uiThem>0 then them=uiThem; foundThem=true end
    end
    return me,them,t
end

-- ===== SAY =====
local function googleTranslate(text,tl,sl)
    if type(HTTP)~="function" or not text or text=="" then return text end
    local ok,res=pcall(function()
        return HTTP({Url=("https://clients5.google.com/translate_a/t?client=dict-chrome-ex&sl=%s&tl=%s&q=%s"):format(HS:UrlEncode(sl or "auto"),HS:UrlEncode(tl),HS:UrlEncode(text)),Method="GET",Headers={["User-Agent"]="Mozilla/5.0"}})
    end)
    if not ok or type(res)~="table" then return text end
    local body=res.Body or res.body; if type(body)~="string" then return text end
    local ok2,d=pcall(function() return HS:JSONDecode(body) end)
    if ok2 and type(d)=="table" and type(d[1])=="string" then return d[1] end
    return text
end
local function getChatBox()
    local t=getTradeRoot(); if not t then return nil end
    local ch=t:FindFirstChild("Chat"); if not ch then return nil end
    for _,k in ipairs({"NormalChat","RestrictedChat"}) do
        local c=ch:FindFirstChild(k); local b=c and c:FindFirstChild("ChatBox")
        b=b and (b:FindFirstChildWhichIsA("TextBox") or b)
        if b and b:IsA("TextBox") then return b end
    end
    return nil
end
local function say(text)
    if not POLICY.autoChat then return false end
    local box=getChatBox(); if not box then return false end
    return (pcall(function()
        box.Text=googleTranslate(text,"en","auto")
        if type(firesignal)=="function" then firesignal(box.FocusLost,true,Enum.KeyCode.Return)
        else box:CaptureFocus(); VIM:SendKeyEvent(true,Enum.KeyCode.Return,false,game); VIM:SendKeyEvent(false,Enum.KeyCode.Return,false,game) end
    end))
end

