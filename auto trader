-- ============ TRADE ROOT ============
local function pg() return LP:FindFirstChild("PlayerGui") end
local function getTradeRoot()
    local p=pg(); if not p then return nil end
    local tl=p:FindFirstChild("TradeLiveTrade"); if not tl then return nil end
    return tl:FindFirstChild("TradeLiveTrade") or tl
end

-- partner name is best-effort; nil must NOT stop processing
local function getPartnerName()
    local t=getTradeRoot(); if not t then return nil end
    local o=t:FindFirstChild("Other"); if not o then return nil end
    local u=o:FindFirstChild("Username")
    if u and u:IsA("TextLabel") then
        local m=u.Text:match("@([%w_]+)")
        if m then return m end
        if u.Text~="" and u.Text~="@" then return u.Text end
    end
    return nil
end

-- True iff any trade frame is present with either side populated
local function tradeOpen()
    local t=getTradeRoot()
    if not t then return false end
    -- presence of Accept button is the strongest signal
    for _,d in ipairs(t:GetDescendants()) do
        if (d:IsA("TextButton") or d:IsA("ImageButton")) and (d.Text or ""):lower():find("accept") then return true end
    end
    -- fallback: existence of Other panel
    return t:FindFirstChild("Other") ~= nil
end

-- ============ SIDE READERS (robust) ============
-- Strategy: find the trade root. Collect ALL items anywhere under it.
-- Split by which side is mine: any label under a subtree whose name mentions
-- "Your"/"My" is mine; else treat text containing a known animal as theirs.
local function readAll()
    local t=getTradeRoot(); if not t then return {},{},{} end
    local my,their={}, {}
    local seen={}

    local function mutFromSiblings(label)
        for _,sib in ipairs(label.Parent:GetChildren()) do
            if sib~=label and sib:IsA("TextLabel") then
                local m=mutOf(sib.Text)
                if MUT_MULT[m] then return m end
            end
        end
        return nil
    end

    local function isMineSubtree(node)
        local n=node:GetFullName():lower()
        return n:find("youritems",1,true) or n:find("yourtrade",1,true)
            or n:find("your side",1,true) or n:find("myitems",1,true)
            or n:find("myoffer",1,true) or n:find("yourside",1,true)
            or n:find("offering",1,true)
    end
    local function isTheirSubtree(node)
        local n=node:GetFullName():lower()
        return n:find("theiritems",1,true) or n:find("theirtrade",1,true)
            or n:find("their side",1,true) or n:find("theirside",1,true)
            or n:find("theiroffer",1,true) or n:find("requesting",1,true)
    end

    for _,d in ipairs(t:GetDescendants()) do
        if d:IsA("TextLabel") and type(d.Text)=="string" and V[d.Text] then
            local full=d:GetFullName()
            if not seen[full] then
                seen[full]=true
                local entry={Index=d.Text,Mutation=mutFromSiblings(d)}
                if isMineSubtree(d) then my[#my+1]=entry
                elseif isTheirSubtree(d) then their[#their+1]=entry
                else
                    -- ambiguous; queue for later heuristic
                    entry.__amb=true; my[#my+1]=entry
                end
            end
        end
    end
    -- any ambiguous left in my -> if their empty and my has >1, split evenly-ish
    if #their==0 and #my>0 then
        local amb={}
        for i=#my,1,-1 do if my[i].__amb then table.insert(amb,1,my[i]); table.remove(my,i) end end
        if #amb>0 then
            for i,e in ipairs(amb) do e.__amb=nil; their[#their+1]=e end
        end
    end
    for _,e in ipairs(my) do e.__amb=nil end
    for _,e in ipairs(their) do e.__amb=nil end
    return my,their,t
end

-- back-compat shims
local function readSide(which)
    local my,their=readAll()
    return which=="me" and my or their
end

-- ============ SAY / TRANSLATE ============
local function googleTranslate(text,tl,sl)
    if type(HTTP)~="function" or not text or text=="" then return text end
    local ok,res=pcall(function()
        return HTTP({Url=("https://clients5.google.com/translate_a/t?client=dict-chrome-ex&sl=%s&tl=%s&q=%s"):format(HS:UrlEncode(sl or "auto"),HS:UrlEncode(tl),HS:UrlEncode(text)),Method="GET",Headers={["User-Agent"]="Mozilla/5.0"}})
    end)
    if not ok or type(res)~="table" then return text end
    local body=res.Body or res.body; if type(body)~="string" then return text end
    local ok2,d=pcall(function() return HS:JSONDecode(body) end)
    if ok2 and type(d)=="table" and type(d[1])=="string" then return d[1] end
    return text
end
local function getChatBox()
    local t=getTradeRoot(); if not t then return nil end
    local ch=t:FindFirstChild("Chat"); if not ch then return nil end
    for _,k in ipairs({"NormalChat","RestrictedChat"}) do
        local c=ch:FindFirstChild(k); local b=c and c:FindFirstChild("ChatBox")
        b=b and (b:FindFirstChildWhichIsA("TextBox") or b)
        if b and b:IsA("TextBox") then return b end
    end
    for _,d in ipairs(t:GetDescendants()) do if d:IsA("TextBox") and d.Name:lower():find("chat") then return d end end
    return nil
end
local function say(text)
    if not POLICY.autoChat then return false end
    local box=getChatBox(); if not box then return false end
    return (pcall(function()
        box.Text=googleTranslate(text,"en","auto")
        if type(firesignal)=="function" then firesignal(box.FocusLost,true,Enum.KeyCode.Return)
        else box:CaptureFocus(); local vim=game:GetService("VirtualInputManager"); vim:SendKeyEvent(true,Enum.KeyCode.Return,false,game); vim:SendKeyEvent(false,Enum.KeyCode.Return,false,game) end
    end))
end

