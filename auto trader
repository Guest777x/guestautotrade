-- diagnostic buttons that COPY dump output to clipboard
local DUMP_OUT=""

local function collectDumpA()
    local lines={}
    local p=pg(); if not p then return "no PlayerGui" end
    for _,sg in ipairs(p:GetChildren()) do
        if sg:IsA("ScreenGui") and sg.Enabled then
            table.insert(lines,"SG: "..sg.Name)
            for _,d in ipairs(sg:GetDescendants()) do
                if d:IsA("TextLabel") and #d.Text>1 then table.insert(lines,"  LBL: "..d:GetFullName().." = "..d.Text) end
                if d:IsA("TextButton") then table.insert(lines,"  BTN: "..d:GetFullName().." text="..d.Text) end
            end
        end
    end
    return table.concat(lines,"\n")
end

local function collectDumpB()
    local t=getTradeRoot(); if not t then return "no trade open" end
    local lines={}
    for _,d in ipairs(t:GetDescendants()) do
        if d:IsA("TextLabel") and #d.Text>1 then table.insert(lines,"LBL: "..d:GetFullName().." = "..d.Text) end
        if d:IsA("ImageLabel") and d.Image~="" then table.insert(lines,"IMG: "..d:GetFullName().." = "..d.Image) end
        if d:IsA("TextButton") then table.insert(lines,"BTN: "..d:GetFullName().." text="..d.Text) end
        if d:IsA("StringValue") or d:IsA("ObjectValue") then table.insert(lines,"VAL: "..d:GetFullName().." = "..tostring(d.Value)) end
        local attrs=d:GetAttributes()
        if next(attrs)~=nil then
            table.insert(lines,"ATTR: "..d:GetFullName())
            for k,v in pairs(attrs) do table.insert(lines,"   "..k.." = "..tostring(v)) end
        end
    end
    return table.concat(lines,"\n")
end

local function collectDumpC()
