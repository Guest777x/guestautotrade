local function readSideCards(sideName)
    local t=getTradeRoot(); if not t then return {},"no root" end
    local side=t:FindFirstChild(sideName)
    if not side then return {},"no side "..sideName end
    local sf=side:FindFirstChild("ScrollingFrame")
    if not sf then return {},"no scroll" end
    local out={}
    local seen={}
    for _,card in ipairs(sf:GetDescendants()) do
        if card:IsA("GuiObject") then
            local spacer=card:FindFirstChild("Spacer",true)
            if spacer then
                local title=spacer:FindFirstChild("Title")
                if title and title:IsA("TextLabel") and type(title.Text)=="string" and title.Text~="" then
                    local clean=title.Text:gsub("<[^>]+>",""):gsub("^%s+",""):gsub("%s+$","")
                    if clean~="" and clean~="Brainrot Name" and clean~="Template" and clean~="Item Name" then
                        local key=spacer:GetFullName()
                        if not seen[key] then
                            seen[key]=true
                            local mut,how=findMutationForCard(spacer,title)
                            out[#out+1]={Index=clean,Mutation=mut,how=how}
                        end
                    end
                end
            end
        end
    end
    return out,"ok"
end
local function readMySide() return readSideCards("Your") end
local function readTheirSide() return readSideCards("Other") end

-- ================================================================
-- CLICK CHAIN — every available non-VIM path, in order
-- ================================================================
local function clickViaFireSignal(btn)
    if not CAP.firesignal then return false,"no firesignal" end
    local fired=false
    pcall(function() firesignal(btn.Activated); fired=true end)
    pcall(function() firesignal(btn.MouseButton1Click); fired=true end)
    return fired,"firesignal"
end
local function clickViaMouse1(btn)
    if not CAP.mouse1click then return false,"no mouse1click" end
    local ap,asz=btn.AbsolutePosition,btn.AbsoluteSize
    if asz.X<2 or asz.Y<2 then return false,"btn size 0" end
    local cx,cy=ap.X+asz.X/2,ap.Y+asz.Y/2
    if CAP.mousemoverel then pcall(function() mousemoverel(0,0) end) end
    if CAP.mousemoveabs then pcall(function() mousemoveabs(cx,cy) end) end
    local ok=pcall(function() mouse1click() end)
    return ok,("mouse1click@"..math.floor(cx)..","..math.floor(cy))
end
local function clickViaPressRelease(btn)
    if not (CAP.mousemoveabs and CAP.mouse1press and CAP.mouse1release) then return false,"no press/release" end
    local ap,asz=btn.AbsolutePosition,btn.AbsoluteSize
    if asz.X<2 or asz.Y<2 then return false,"btn size 0" end
    local cx,cy=ap.X+asz.X/2,ap.Y+asz.Y/2
    local ok=pcall(function()
        mousemoveabs(cx,cy)
        task.wait(0.03)
        mouse1press()
        task.wait(0.04)
        mouse1release()
    end)
    return ok,("press/rel@"..math.floor(cx)..","..math.floor(cy))
end
local function clickChain(btn,label)
    if not btn then return false,"no btn" end
    local paths={clickViaFireSignal,clickViaMouse1,clickViaPressRelease}
    local tried={}
    for _,fn in ipairs(paths) do
        local ok,how=fn(btn)
        table.insert(tried,tostring(how))
        if ok then
            logOk(("click[%s] %s via %s"):format(tostring(label),tostring(how),btn:GetFullName()))
            return true,how
        end
    end
    logWarn(("click[%s] all paths failed: %s"):format(tostring(label),table.concat(tried,"|")))
    return false,"all failed"
end

