-- ============ ACCEPT LOOP (rewritten) ============
-- Runs whenever a trade window exists. Does NOT depend on partner name.
-- Debounce is per (partner, myValue, theirValue) signature so re-reads don't re-fire.
local lastAcceptedSig=nil
local lastAcceptAt=0
task.spawn(function()
    while gui.Parent do
        pcall(function()
            if not tradeOpen() then
                if not status.Text:find("ACCEPT") then
                    status.Text="IDLE"; status.TextColor3=THEME.DIM
                end
                readout.Text="open a trade — values shown here"
                return
            end
            local my,their=getTradeRoot() and readAll() or {},{}
            local mv=listValue(my); local tv=listValue(their)
            local p=getPartnerName() or "?"
            readout.Text=("PARTNER: %s\nMY: %dG (%d) | THEIRS: %dG (%d)\nMARGIN: %+dG | ROUNDS: %d"):format(p,mv,#my,tv,#th or 0,tv-mv,NEGO.rounds)
            if not POLICY.autoAccept then return end
            if #their==0 then
                status.Text="TRADE OPEN — THEIR SIDE EMPTY"; status.TextColor3=THEME.DIM
                return
            end
            if (tv-mv) < POLICY.minMargin then
                status.Text=("WAITING — MARGIN %+dG"):format(tv-mv); status.TextColor3=THEME.DIM
                return
            end
            local sig=("%s|%d|%d"):format(p,mv,tv)
            if sig==lastAcceptedSig and (os.clock()-lastAcceptAt)<4 then return end
            local b=findBtn({"accept","confirm"})
            if b then
                lastAcceptedSig=sig; lastAcceptAt=os.clock()
                task.wait(0.35); press(b); say("deal, thanks")
                status.Text="ACCEPTED: "..p; status.TextColor3=THEME.SUCCESS
            else
                status.Text="FAIR TRADE — ACCEPT BTN NOT FOUND"; status.TextColor3=THEME.DANGER
            end
        end)
        task.wait(0.4)
    end
end)

