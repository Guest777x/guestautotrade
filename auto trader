local lastSig=nil; local lastT=0
task.spawn(function()
    while gui.Parent do
        pcall(function()
            if not tradeOpen() then
                if not status.Text:find("ACCEPT") and not status.Text:find("SET") and not status.Text:find("REPLIED") and not status.Text:find("WAIT") and not status.Text:find("TRADE") and not status.Text:find("OPEN") then
                    status.Text="IDLE"; status.TextColor3=THEME.DIM
                end
                readout.Text="open a trade — values shown here"
                return
            end
            local my=readMySide(); local their=readTheirSide()
            local mv=listValue(my); local tv=listValue(their)
            local p=getPartnerName() or "?"
            readout.Text=("PARTNER: %s\nMY: %dG (%d items) | THEIRS: %dG (%d items)\nMARGIN: %+dG"):format(p,mv,#my,tv,#their,tv-mv)
            if not POLICY.autoAccept then return end
            if #their==0 then status.Text="TRADE OPEN — THEIRS 0"; status.TextColor3=THEME.DIM; return end
            if (tv-mv)<POLICY.minMargin then status.Text=("WAIT — MARGIN %+dG"):format(tv-mv); status.TextColor3=THEME.DIM; return end
            local sig=("%s|%d|%d"):format(p,mv,tv)
            if sig==lastSig and (os.clock()-lastT)<4 then return end
            local clicked=false
            if tryReadyButton() then clicked=true end
            if clicked then
                lastSig=sig; lastT=os.clock(); say("deal, thanks")
                status.Text="ACCEPTED: "..p; status.TextColor3=THEME.SUCCESS
            else
                status.Text="FAIR — ready button not in accept state"; status.TextColor3=THEME.DIM
            end
        end)
        task.wait(0.4)
    end
end)

local function attachChat()
    local t=getTradeRoot(); if not t then return end
    local ch=t:FindFirstChild("Chat"); if not ch then return end
    for _,k in ipairs({"NormalChat","RestrictedChat"}) do
        local c=ch:FindFirstChild(k); if not c then continue end
        local sf=c:FindFirstChild("ScrollingFrame"); if not sf then continue end
        sf.ChildAdded:Connect(function(child)
            task.defer(function()
                task.wait(0.15)
                local lbl=child:FindFirstChild("Label",true); if not lbl or type(lbl.Text)~="string" then return end
                if lbl.Text=="Template" then return end
                local nm=child.Name
                local pi=child:FindFirstChild("PlayerImage"); pi=pi and pi:FindFirstChild("Headshot")
                local isMe=false
                if nm=="TemplateYou" then isMe=true end
                if pi and type(pi.Image)=="string" then local m=pi.Image:match("id=(%d+)"); if m and tonumber(m)==LP.UserId then isMe=true end end
                if isMe then return end
                negotiate(lbl.Text)
                if lastReply~="" then status.Text="REPLIED: "..lastReply; status.TextColor3=THEME.ACCENT end
            end)
        end)
    end
end
