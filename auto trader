local function readSideCards(sideName)
    local t=getTradeRoot(); if not t then return {} end
    local side=t:FindFirstChild(sideName); if not side then return {} end
    local sf=side:FindFirstChild("ScrollingFrame"); if not sf then return {} end
    local out={}
    for _,card in ipairs(sf:GetDescendants()) do
        if card:IsA("GuiObject") then
            local spacer=card:FindFirstChild("Spacer",true)
            local title=spacer and spacer:FindFirstChild("Title")
            if title and type(title.Text)=="string" and title.Text~="" then
                local clean=title.Text:gsub("<[^>]+>",""):gsub("^%s+",""):gsub("%s+$","")
                if clean~="" and clean~="Brainrot Name" and clean~="Template" then
                    local mut=nil
                    for _,d in ipairs((spacer or card):GetDescendants()) do
                        if d:IsA("TextLabel") and d~=title and type(d.Text)=="string" and #d.Text<30 then
                            local m=mutOf(d.Text); if MUT_MULT[m] and m~="None" then mut=m; break end
                        end
                    end
                    out[#out+1]={Index=clean,Mutation=mut}
                end
            end
        end
    end
    local seen={}; local dedup={}
    for _,e in ipairs(out) do local k=e.Index.."|"..tostring(e.Mutation); if not seen[k] then seen[k]=true; dedup[#dedup+1]=e end end
    return dedup
end
