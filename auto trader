    if not Sync then lines[#lines+1]="Synchronizer missing"; return table.concat(lines,"\n") end
    local plots=workspace:FindFirstChild("Plots"); if not plots then return "Plots missing" end
    local lp=LP.Name
    for _,p in ipairs(plots:GetChildren()) do
        local ok,t=pcall(function() return Sync:GetTableFromChannel(p.Name) end)
        if ok and type(t)=="table" then
            local owner=t.Owner
            local n=typeof(owner)=="Instance" and owner.Name or tostring(owner)
            if n==lp or n==LP.DisplayName then
                lines[#lines+1]="MY PLOT: "..p.Name
                for k,v in pairs(t) do lines[#lines+1]="  field: "..k.." ("..type(v)..")" end
                if type(t.AnimalList)=="table" then
                    for i,e in ipairs(t.AnimalList) do
                        lines[#lines+1]="  animal "..i..": "..(type(e)=="table" and (tostring(e.Index).." mut="..tostring(e.Mutation)) or tostring(e))
                    end
                end
            end
        end
    end
    if #lines==0 then lines[#lines+1]="no plot owned by "..lp.." found" end
    return table.concat(lines,"\n")
end

