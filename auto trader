local function mutOf(r)
    if not r or r=="" or r=="None" then return "None" end
    local s=tostring(r):gsub("^%s+",""):gsub("%s+$","")
    local al=MUT_ALIAS[s]; if al then return al end
    if MUT_MULT[s] then return s end
    local low=s:lower()
    if low:find("gold") and low:find("diamond") then return "Gold and Diamond" end
    if low:find("gold") then return "Gold" end
    if low:find("diamond") then return "Gold and Diamond" end
    return s
end
local function itemValue(e)
    if type(e)~="table" then return 0 end
    local b=V[e.Index]; if not b then return 0 end
    return b*(MUT_MULT[mutOf(e.Mutation)] or 1.0)
end
local function listValue(l) local t=0 if type(l)~="table" then return 0 end for _,e in ipairs(l) do t=t+itemValue(e) end return t end
local function offerFor(v) return v-math.min(math.ceil(v*POLICY.offerShave),POLICY.offerFloor) end

