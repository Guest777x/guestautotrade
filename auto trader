local SENT_TEXTS={}
local function googleTranslate(text,tl,sl)
    if type(HTTP)~="function" or not text or text=="" then return text end
    local ok,res=pcall(function()
        return HTTP({Url=("https://clients5.google.com/translate_a/t?client=dict-chrome-ex&sl=%s&tl=%s&q=%s"):format(HS:UrlEncode(sl or "auto"),HS:UrlEncode(tl),HS:UrlEncode(text)),Method="GET",Headers={["User-Agent"]="Mozilla/5.0"}})
    end)
    if not ok or type(res)~="table" then return text end
    local body=res.Body or res.body; if type(body)~="string" then return text end
    local ok2,d=pcall(function() return HS:JSONDecode(body) end)
    if ok2 and type(d)=="table" and type(d[1])=="string" then return d[1] end
    return text
end
