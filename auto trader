local lastSayAt=0
local function say(text)
    if not POLICY.autoChat then return false end
    local now=os.clock()
    local minGap=POLICY.chatDelayMin or 1.5
    local wait=math.max(0, minGap-(now-lastSayAt))
    if wait>0 then task.wait(wait) end
    task.wait(math.random(math.floor(POLICY.chatDelayMin*1000), math.floor(POLICY.chatDelayMax*1000))/1000)
    local box=getChatBox(); if not box then return false end
    lastSayAt=os.clock()
    SENT_TEXTS[text:lower()]=os.time()
    return (pcall(function()
        box.Text=googleTranslate(text,"en","auto")
        if type(firesignal)=="function" then
            pcall(function() firesignal(box.FocusLost,true,Enum.KeyCode.Return) end)
        end
        local sendBtn
        local cb=box.Parent
        if cb then
            local cbs=cb.Parent and cb.Parent:FindFirstChild("ChatBoxSend")
            if cbs then sendBtn=cbs:FindFirstChild("Send") end
        end
        if sendBtn and sendBtn:IsA("ImageButton") then clickGui(sendBtn) end
        VIM:SendKeyEvent(true,Enum.KeyCode.Return,false,game)
        VIM:SendKeyEvent(false,Enum.KeyCode.Return,false,game)
    end))
end

