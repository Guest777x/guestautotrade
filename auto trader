-- ================================================================
-- MUTATION DETECTION — 4 strategies
-- ================================================================
local function findMutationForCard(spacer,titleLabel)
    -- strategy 1: scan spacer descendants for a TextLabel with a known mut
    for _,d in ipairs(spacer:GetDescendants()) do
        if d:IsA("TextLabel") and d~=titleLabel and type(d.Text)=="string" and #d.Text<30 then
            local m=mutOf(d.Text)
            if MUT_MULT[m] and m~="None" then return m,"textlabel" end
        end
    end
    -- strategy 2: scan attributes on spacer and children for mutation name string
    for _,d in ipairs(spacer:GetDescendants()) do
        for k,v in pairs(d:GetAttributes()) do
            if type(v)=="string" then
                local m=mutOf(v)
                if MUT_MULT[m] and m~="None" then return m,"attr:"..k end
            end
        end
    end
    -- strategy 3: scan spacer for ImageLabel whose image asset or Name contains a mut
    for _,d in ipairs(spacer:GetDescendants()) do
        if d:IsA("ImageLabel") then
            local m=mutOf(d.Name)
            if MUT_MULT[m] and m~="None" then return m,"imagename" end
        end
    end
    -- strategy 4: walk up to card root, scan all
    local node=spacer.Parent
    if node then
        for _,d in ipairs(node:GetDescendants()) do
            if d:IsA("TextLabel") and type(d.Text)=="string" and #d.Text<30 then
                local m=mutOf(d.Text)
                if MUT_MULT[m] and m~="None" then return m,"cardwalk" end
            end
        end
    end
    return nil,"none"
end

