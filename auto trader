local function mutOf(r)
    if not r or r=="" or r=="None" or r=="nil" or r=="Default" then return "None" end
    local s=tostring(r):gsub("^%s+",""):gsub("%s+$",""):gsub("<[^>]+>","")
    s=s:gsub("&amp;","&")
    if MUT_ALIAS[s] then return MUT_ALIAS[s] end
    if MUT_MULT[s] then return s end
    local low=s:lower()
    if low:find("gold") and low:find("diamond") then return "Gold and Diamond" end
    if low:find("yin") and low:find("yang") then return "Yin Yang" end
    if low:find("candy") and low:find("cane") then return "Candy Cane" end
    if low:find("blood") then return "Bloodmoon" end
    if low:find("gold") then return "Gold" end
    if low:find("diamond") then return "Gold and Diamond" end
    return s
end
local function itemValue(e)
    if type(e)~="table" then return 0 end
    local b=V[e.Index]; if not b then return 0 end
    return b*(MUT_MULT[mutOf(e.Mutation)] or 1.0)
end
local function listValue(l)
    if type(l)~="table" then return 0 end
    local t=0; for _,e in ipairs(l) do t=t+itemValue(e) end; return t
end

